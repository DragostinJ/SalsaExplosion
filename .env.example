# ==========================================
# DATABASE (PostgreSQL / Supabase)
# ==========================================
# Connect to Supabase via connection pooling with Supavisor / PgBouncer
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ==========================================
# AUTHENTICATION (Clerk)
# ==========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ==========================================
# PAYMENTS (Stripe)
# ==========================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe Price IDs (created in your Stripe Dashboard)
STRIPE_PRICE_SINGLE_DROPIN="price_..."
STRIPE_PRICE_5_PACK="price_..."
STRIPE_PRICE_10_PACK="price_..."
STRIPE_PRICE_UNLIMITED_MONTHLY="price_..."

# App URL for Stripe redirect callbacks
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================
# STORAGE & ASSETS (Supabase Storage)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ==========================================
# ACCESS CONTROL & SECURITY
# ==========================================
# Comma-separated allowlist of studio owner/admin emails (auto-promoted on first login)
ADMIN_EMAILS="owner@salsaexplosion.co.uk"

# Comma-separated allowlist of emails allowed to toggle the demo role switcher in non-production
DEMO_SWITCHER_EMAILS="owner@salsaexplosion.co.uk"

# DANGER: Set to true ONLY in local development to test role switcher.
# Must NEVER be set in production! next.config.ts will abort build if true in production.
ALLOW_DEMO_ROLE_SWITCHING="false"
ALLOW_DEMO_EVENT_REGISTRATION="false"

# ==========================================
# RATE LIMITING (Upstash Redis)
# ==========================================
# Optional: In development/CI falls back to in-memory sliding window
UPSTASH_REDIS_REST_URL="https://[YOUR-ID].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR-TOKEN]"

# ==========================================
# EMAILS & NOTIFICATIONS (Resend)
# ==========================================
RESEND_API_KEY="re_..."


# ==========================================
# PLAYWRIGHT AUTHENTICATED E2E TESTS (Optional)
# ==========================================
# If omitted, authenticated E2E tests skip automatically.
# See docs/E2E_AUTH.md for setup instructions.
# E2E_CLERK_USER_USERNAME=""
# E2E_CLERK_USER_PASSWORD=""
