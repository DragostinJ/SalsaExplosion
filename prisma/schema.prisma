// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Required for Supabase connection pooling (PgBouncer)
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum DanceLevel {
  BEGINNER
  IMPROVER
  INTERMEDIATE
  ADVANCED
}

enum DanceStyle {
  CUBAN_SALSA
}

enum DanceRole {
  LEAD
  FOLLOW
  SOLO // For footwork/styling classes
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  ATTENDED
  NO_SHOW
  WAITLISTED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum TransactionType {
  CREDIT_PACK_PURCHASE
  SUBSCRIPTION_RENEWAL
  CLASS_BOOKING_DEDUCTION
  CLASS_CANCELLATION_REFUND
  ADMIN_ADJUSTMENT
}

enum AuditAction {
  ROLE_CHANGE
  CREDIT_ADJUSTMENT
  LEVEL_PROMOTION
  CSV_EXPORT
  EVENT_MUTATION
  REFUND
}

// ==========================================
// MODELS
// ==========================================

model User {
  id               String     @id @default(cuid())
  clerkId          String     @unique
  email            String     @unique
  firstName        String
  lastName         String
  avatarUrl        String?
  bio              String?    @db.Text
  specialty        String?    // e.g. "Rueda de Casino & Afro-Cuban Bodymovement"
  yearsDancing     Int?       @default(8)
  role             Role       @default(STUDENT)
  
  // Progression & Credits
  currentLevel     DanceLevel @default(BEGINNER)
  preferredRole    DanceRole  @default(LEAD)
  classCredits     Int        @default(0)
  
  // Stripe Integration
  stripeCustomerId String?    @unique

  // Relations
  taughtClasses    ClassSession[]    @relation("InstructorClasses")
  bookings         Booking[]
  submissions      VideoSubmission[] @relation("StudentSubmissions")
  reviews          VideoSubmission[] @relation("InstructorReviews")
  subscription     Subscription?
  transactions     CreditLedger[]
  eventRegistrations EventRegistration[]
  waitlistEntries    PartnerWaitlistEntry[]
  privateLessons     PrivateLessonBooking[]
  merchReservations  MerchReservation[]
  postClassFeedbacks PostClassFeedback[]
  auditLogs          AuditLog[]
  songSectionProgress SongSectionProgress[]

  classRemindersOptOut Boolean @default(false) // unsubscribed from class reminder emails

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([clerkId])
  @@index([role])
}

model ClassSession {
  id             String     @id @default(cuid())
  title          String     // e.g., "Cuban Salsa Casino & Rueda"
  description    String?
  style          DanceStyle @default(CUBAN_SALSA)
  minLevel       DanceLevel @default(BEGINNER)
  
  // Scheduling
  startTime      DateTime
  endTime        DateTime
  room           String     @default("Studio A")
  
  // Capacity Management
  maxCapacity    Int        // Total hard cap
  maxLeads       Int?       // Optional cap for Leads
  maxFollows     Int?       // Optional cap for Follows
  bookedCount    Int        @default(0) // Denormalized for fast read locks
  
  // Pricing
  creditCost     Int        @default(1)
  isCancelled    Boolean    @default(false)

  // End-of-class Teacher Recap Video & Figures Practiced
  recapVideoUrl  String?
  recapNotes     String?    @db.Text
  recapFigures   String[]   @default([])
  recapRecordedAt DateTime?
  recapPublished Boolean    @default(false)

  // Practice-player songs the teacher used in this class (ids from TIMBA_SONG_ANATOMY_DATA)
  practiceSongIds String[]  @default([])

  // Relations
  instructorId   String
  instructor     User       @relation("InstructorClasses", fields: [instructorId], references: [id], onDelete: Restrict)
  bookings       Booking[]
  feedbacks      PostClassFeedback[]

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([startTime, style, minLevel])
  @@index([instructorId])
  @@index([recapPublished])
}

model Booking {
  id             String        @id @default(cuid())
  userId         String
  classSessionId String
  danceRole      DanceRole     // Role booked for this specific class
  status         BookingStatus @default(CONFIRMED)
  
  checkedInAt    DateTime?
  cancelledAt    DateTime?
  reminderSentAt DateTime? // class reminder email sent (one per booking)

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSession   ClassSession  @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Prevent double-booking the exact same class
  @@unique([userId, classSessionId])
  @@index([classSessionId, status])
  @@index([userId, status])
}

model VideoSubmission {
  id             String           @id @default(cuid())
  studentId      String
  instructorId   String?          // Populated when an instructor claims/grades it
  
  style          DanceStyle       @default(CUBAN_SALSA)
  currentLevel   DanceLevel       // Snapshot of student's level at submission
  targetLevel    DanceLevel       // Level the student is applying for
  
  videoUrl       String           // Supabase Storage path or Mux Playback ID
  studentNotes   String?          @db.Text
  
  status         SubmissionStatus @default(PENDING)
  feedback       String?          @db.Text // Required if REJECTED
  reviewedAt     DateTime?

  student        User             @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  instructor     User?            @relation("InstructorReviews", fields: [instructorId], references: [id], onDelete: SetNull)

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([studentId, status])
  @@index([status, createdAt])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeSubscriptionId String             @unique
  stripePriceId        String
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model CreditLedger {
  id                    String          @id @default(cuid())
  userId                String
  amount                Int             // Positive for additions, negative for deductions
  balanceAfter          Int             // Snapshot of user.classCredits after tx
  type                  TransactionType
  description           String?
  
  // Idempotency & Audit Links
  stripePaymentIntentId String?         @unique
  bookingId             String?

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime        @default(now())

  @@index([userId, createdAt])
}

// ==========================================
// GUEST ARTIST WORKSHOPS & EVENT TICKETING
// ==========================================

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum TicketPaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model Event {
  id            String              @id @default(cuid())
  slug          String              @unique
  title         String
  description   String              @db.Text
  coverImageUrl String?
  venueName     String
  venueAddress  String
  startDate     DateTime
  endDate       DateTime
  guestArtists  String[]
  status        EventStatus         @default(DRAFT)

  ticketTiers   EventTicketTier[]
  registrations EventRegistration[]

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, startDate])
}

model EventTicketTier {
  id            String              @id @default(cuid())
  eventId       String
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name          String              // e.g. "Full Weekend Pass", "Bootcamp Intensive", "Saturday Party Only"
  description   String?
  priceInCents  Int                 // e.g. 7500 = £75.00
  totalCapacity Int
  maxLeads      Int?
  maxFollows    Int?
  salesStartAt  DateTime            @default(now())
  salesEndAt    DateTime

  registrations EventRegistration[]

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([eventId])
}

model EventRegistration {
  id                 String              @id @default(cuid())
  userId             String
  eventId            String
  ticketTierId       String
  role               DanceRole           @default(LEAD)
  qrCodeHash         String              @unique @default(cuid())
  paymentStatus      TicketPaymentStatus @default(PAID)
  amountPaidInCents  Int
  checkedIn          Boolean             @default(false)
  checkedInAt        DateTime?
  stripeSessionId    String?             @unique

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  event              Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTier         EventTicketTier     @relation(fields: [ticketTierId], references: [id], onDelete: Cascade)

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId])
  @@index([eventId, role])
  @@index([ticketTierId])
  @@index([qrCodeHash])
}

// ==========================================
// AUDIT & WEBHOOK IDEMPOTENCY
// ==========================================

model ProcessedWebhookEvent {
  id        String   @id // The Stripe or Svix event id
  eventType String
  createdAt DateTime @default(now())
}

// ==========================================
// ROLE BALANCE WAITLIST & PAIRING
// ==========================================

model PartnerWaitlistEntry {
  id           String    @id @default(cuid())
  userId       String
  role         DanceRole
  status       String    @default("WAITING") // WAITING, PAIRED, CANCELLED
  partnerEmail String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([role, status])
}

// ==========================================
// 1-ON-1 PRIVATE LESSONS & COACHING
// ==========================================

model PrivateLessonBooking {
  id               String    @id @default(cuid())
  studentId        String
  instructorName   String    // e.g. "Maestro Enrique Perez Valdes"
  focusTopic       String    // e.g. "Cuban Motion & Isolation"
  packageType      String    // "SINGLE_1HR" | "BLOCK_5HR"
  preferredSlot    String    // e.g. "Friday 17:00"
  totalPricePounds Int
  status           String    @default("PENDING") // PENDING, CONFIRMED, COMPLETED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  student          User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
}

// ==========================================
// SALSA EXPLOSION MERCH & ESSENTIALS
// ==========================================

model MerchReservation {
  id          String   @id @default(cuid())
  userId      String
  itemId      String
  itemName    String
  size        String?
  pricePounds Int
  status      String   @default("RESERVED") // RESERVED, COLLECTED, CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ==========================================
// BEGINNER PSYCHOLOGICAL SAFETY & SUPPORT
// ==========================================

model AnonymousQuestion {
  id        String   @id @default(cuid())
  category  String   // "FOOTWEAR", "RHYTHM", "PARTNER_ANXIETY", "VENUE_ARRIVING", "GENERAL"
  question  String   @db.Text
  email     String?  // Optional for direct follow-up
  status    String   @default("ANSWERED")
  response  String?  @db.Text
  createdAt DateTime @default(now())

  @@index([category, status])
}

model PostClassFeedback {
  id             String   @id @default(cuid())
  userId         String
  classSessionId String
  sentiment      String   // "LOVED_IT" | "CHALLENGING_FUN" | "A_BIT_OVERWHELMED"
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@unique([userId, classSessionId])
  @@index([classSessionId, sentiment])
}

// ==========================================
// AUDIT LOG
// ==========================================

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String
  action     AuditAction
  targetType String
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime    @default(now())

  actor      User        @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}


// AI Studio announcements approved by staff and shown on /events.
// The card is stored as validated JSON and re-parsed with ParsedEventCardSchema on read.
model PublishedAnnouncement {
  id            String   @id
  title         String
  card          Json
  publishedById String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([updatedAt])
}

// Dancer marks a song section as "got it" in the practice player.
// songId/sectionId reference TIMBA_SONG_ANATOMY_DATA (validated in the server action).
model SongSectionProgress {
  id        String   @id @default(cuid())
  userId    String
  songId    String
  sectionId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, songId, sectionId])
  @@index([userId, songId])
}

// Anonymous practice-player counts per section per day (no user ids are stored):
// how often dancers loop or go back to a section. Shows teachers where students struggle.
model PracticeSectionStat {
  id        String   @id @default(cuid())
  songId    String
  sectionId String
  day       DateTime @db.Date
  loops     Int      @default(0)
  replays   Int      @default(0)

  @@unique([songId, sectionId, day])
  @@index([day])
}
