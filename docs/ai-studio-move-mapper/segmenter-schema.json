{
  "type": "object",
  "properties": {
    "pieces": {
      "type": "array",
      "description": "In time order, never overlapping, 8-30 s each",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "description": "Piece start as \"M:SS\""
          },
          "end": {
            "type": "string",
            "description": "Piece end as \"M:SS\""
          },
          "kind": {
            "type": "string",
