{
  "name": "salsa-explosion",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack dance academy management, event ticketing, and interactive music trainer built with Next.js 16, TypeScript, Prisma, PostgreSQL, Clerk, and Stripe.",
  "author": "Dragostin J.",
  "keywords": [
    "nextjs",
    "react19",
    "typescript",
    "prisma",
    "postgresql",
    "supabase",
    "clerk",
    "stripe",
    "web-audio-api",
    "playwright",
    "vitest"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy && prisma db seed",
    "db:seed": "prisma db seed",
    "test:e2e:degraded": "node scripts/run-degraded-e2e.mjs",
    "media:check": "node scripts/check-media.mjs",
    "audit:design": "node scripts/visual-audit.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.16",
    "@google/genai": "^2.32.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "svix": "^2.8.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
