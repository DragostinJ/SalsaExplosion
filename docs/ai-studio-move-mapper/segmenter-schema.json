            "enum": [
              "partnerwork",
              "solo",
              "rumba",
              "break",
              "not-dancing"
            ],
            "description": "What happens in this piece"
          },
          "label": {
            "type": "string",
            "description": "A few plain words about what happens"
          }
        },
        "required": [
          "start",
          "end",
          "kind",
          "label"
        ],
        "propertyOrdering": [
          "start",
          "end",
          "kind",
          "label"
        ]
      }
    },
    "notes": {
      "type": "string",
      "description": "What made the video hard to cut (camera cuts, crowd, no clear figure ends)"
    }
  },
  "required": [
    "pieces",
    "notes"
  ],
  "propertyOrdering": [
    "pieces",
    "notes"
  ]
